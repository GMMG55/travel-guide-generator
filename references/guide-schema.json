{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/GMMG55/travel-guide-generator/guide-schema.json",
  "title": "Travel Guide",
  "type": "object",
  "required": ["schema_version", "meta", "preferences", "days"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "meta": {
      "type": "object",
      "required": ["title", "destination", "language", "start_date", "days"],
      "properties": {
        "title": {"type": "string", "minLength": 1},
        "destination": {"type": "string", "minLength": 1},
        "origin": {"type": "string"},
        "language": {"type": "string"},
        "start_date": {"type": "string", "format": "date"},
        "days": {"type": "integer", "minimum": 1},
        "travelers": {"type": "integer", "minimum": 1},
        "currency": {"type": "string"},
        "destination_coords": {
          "type": "array",
          "prefixItems": [{"type": "number"}, {"type": "number"}],
          "minItems": 2,
          "maxItems": 2
        }
      }
    },
    "preferences": {
      "type": "object",
      "properties": {
        "budget_level": {"enum": ["economy", "comfortable", "premium"]},
        "pace": {"enum": ["relaxed", "balanced", "intensive"]},
        "group_type": {"type": "string"},
        "interests": {"type": "array", "items": {"type": "string"}},
        "dietary": {"type": "array", "items": {"type": "string"}},
        "accessibility": {"type": "array", "items": {"type": "string"}},
        "transport": {"type": "array", "items": {"type": "string"}},
        "earliest_start": {"type": "string", "pattern": "^[0-2][0-9]:[0-5][0-9]$"},
        "latest_end": {"type": "string", "pattern": "^[0-2][0-9]:[0-5][0-9]$"}
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "type", "checked_at"],
        "properties": {
          "id": {"type": "string"},
          "title": {"type": "string"},
          "url": {"type": "string"},
          "type": {"enum": ["official", "search", "user", "estimate", "general"]},
          "checked_at": {"type": "string", "format": "date"}
        }
      }
    },
    "weather": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["date", "condition"],
        "properties": {
          "date": {"type": "string", "format": "date"},
          "condition": {"type": "string"},
          "temp_low": {"type": "number"},
          "temp_high": {"type": "number"},
          "backup_plan": {"type": "string"},
          "source_ids": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "days": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["day", "date", "title", "items"],
        "properties": {
          "day": {"type": "integer", "minimum": 1},
          "date": {"type": "string", "format": "date"},
          "title": {"type": "string"},
          "items": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["name", "start", "end"],
              "properties": {
                "name": {"type": "string"},
                "type": {"enum": ["spot", "meal", "transport", "hotel", "activity"]},
                "start": {"type": "string"},
                "end": {"type": "string"},
                "coords": {
                  "type": "array",
                  "prefixItems": [{"type": "number"}, {"type": "number"}],
                  "minItems": 2,
                  "maxItems": 2
                },
                "source_ids": {"type": "array", "items": {"type": "string"}}
              }
            }
          }
        }
      }
    }
  }
}
